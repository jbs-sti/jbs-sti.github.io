{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jbs-sti.github.io/schemas/ressource.schema.json",
  "title": "Métadonnées d’une ressource",
  "type": "object",
  "required": [
    "title",
    "description",
    "type",
    "domaine",
    "chapitre",
    "categories",
    "mots-cles",
    "objectifs",
    "prerequis",
    "duree",
    "order",
    "date-modified",
    "draft"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "chapitre": {
      "type": "string",
      "minLength": 1
    },
    "duree": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "cours",
        "tp",
        "exercices",
        "fiche"
      ]
    },
    "domaine": {
      "type": "string",
      "enum": [
        "reseaux",
        "programmation",
        "cybersecurite",
        "systemes",
        "electronique",
        "snt"
      ]
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "mots-cles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "objectifs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "prerequis": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "date-modified": {
      "type": "string",
      "format": "date"
    },
    "draft": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "x-formations": [
    "snt",
    "bts1",
    "bts2"
  ],
  "x-chapitre-pattern": "^[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
  "x-sujet-pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
}
